{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Override module settings for CommonJS output
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    
    // Output to dist-cjs directory
    "outDir": "./dist-cjs",
    
    // Disable ES module interop for cleaner CommonJS
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  }
}