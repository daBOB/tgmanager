# ClaudeKit Ignore File - SIZE-based blocking
# Blocks directories with heavy file counts that fill LLM context
# Syntax: gitignore-spec | Use ! prefix to allow (e.g., !src/vendor)

# JS/TS
node_modules
dist
build
.next
.nuxt

# Python
__pycache__
.venv
venv

# Go/PHP/Rust/Java
vendor
target

# VCS & Coverage
.git
coverage

# Allow reading these files
!.env
!.env.*

# The `build` pattern above also matches the substring in Bash commands,
# blocking legitimate compile invocations (bun run build:ts, bun build --compile).
# No build/ directory exists in this repo, so the pattern only cost false positives.
!build